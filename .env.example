DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=lms_db
PORT=3001

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3001

# Database Configuration (SimAsset Integration)
SIMAS_HOST=localhost
SIMAS_USER=root
SIMAS_PASSWORD=
SIMAS_NAME=simasset
SIMAS_PORT=3306

# Email Service (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google OAuth (Optional - required for real login)
VITE_GOOGLE_CLIENT_ID=

# External API (OAuth2 client_credentials) - lets other systems fetch an employee's
# Total Learning Hours via POST /api/oauth/token then GET /api/external/v1/employees/:id/learning-hours
EXTERNAL_API_CLIENT_ID=
EXTERNAL_API_CLIENT_SECRET=
EXTERNAL_API_TOKEN_TTL=3600

# Signs login session tokens. Required in production - if unset, a random secret is generated on
# each start and every restart logs all users out. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Public LMS URL - ticket comments link back to the record (e.g. https://lms.nusa.id/admin/idp?idp=12)
APP_BASE_URL=https://lms.nusa.id

# Master switch for every IS5 general ticket (all flows below). Anything but "true" = no ticket is sent.
FITUR_GENERAL_TICKET=false

# IS5 General Ticket (GT) API - used by POST /api/general-tickets
IS5_GENERAL_TICKET_URL=https://legacy.is5.nusa.net.id/api/client/v1/general-tickets/
IS5_API_KEY=
# Employee IDs (HR) that follow every general ticket, comma-separated, e.g. 0201101,0200701 (empty = no followers)
IS5_TICKET_FOLLOW=
# IS5 follow-group IDs that follow every general ticket, comma-separated (empty = no follow groups)
IS5_TICKET_FOLLOW_GROUP=
# Days until a general ticket expires (time_expired), counted from when it's created. Default 3.
IS5_TICKET_EXPIRED_DAYS=3
# HR employee ID that is the PIC of the tickets raised when an employee imports their own IDP
# or a leader approves an external training request (fallback for NUSAWORK_TASK_HR_EMPLOYEE_ID)
IS5_TICKET_PIC_HR=

# Nusawork Task Management - every reminder/notification below is a Nusawork task (not an IS5 ticket).
# Master switch: no task is created from any flow unless "true".
FITUR_NUSAWORK_TASK=false
# Optional Nusawork user_id (employees.user_id) set as the reporter of every task, e.g. an HR/system
# account. Leave empty to send tasks with reporter_id: null.
NUSAWORK_TASK_REPORTER_ID=
# Nusawork account the tasks are created with (password grant), through a client that accepts
# password grants (e.g. client 4). Needed for now: Task Management rejects the client_credentials
# token (HTTP 500), so it needs a token tied to a user. Leave all four empty to use the
# NUSAWORK_CLIENT_ID token instead, once Nusawork allows it for tasks.
NUSAWORK_TASK_USERNAME=
NUSAWORK_TASK_PASSWORD=
NUSAWORK_TASK_CLIENT_ID=
NUSAWORK_TASK_CLIENT_SECRET=
# HR employee ID that gets the HR tasks: leader-approved external training, missing certificate,
# imported IDP. Falls back to IS5_TICKET_PIC_HR.
NUSAWORK_TASK_HR_EMPLOYEE_ID=

# Monthly (from H-7 before month end) task to each leader whose team has unreviewed IDPs.
# Enable only in production - otherwise a dev copy of the data would send real tickets.
IDP_REVIEW_REMINDERS_ENABLED=false
# Quarterly (from H-14 before the quarter ends) task to each leader whose team members have no
# competency assessment yet this quarter. Enable only in production, same as above.
COMPETENCY_REMINDERS_ENABLED=false
# Task to each new employee (joined in the last 30 days, no IDP yet this year) to write their
# IDP within their first month. Enable only in production, same as above.
IDP_NEW_EMPLOYEE_REMINDERS_ENABLED=false
# Every 6 hours, add new hires (joined in the last 30 days or joining later) that are active in
# Nusawork but missing from the local employees table, so they show up (and get the IDP ticket
# above) without waiting for HR's Sync All. Existing employees are never changed by this job.
NUSAWORK_NEW_EMPLOYEE_SYNC_ENABLED=false
# Task to each leader who still hasn't filled in a Post Training Evaluation 7 days before
# their 30-day window (from the training's close) runs out. Enable only in production, same as above.
PTE_REMINDERS_ENABLED=false
# Monthly (from H-3 before month end) task to each staff whose IDP for this year is still missing or
# an unsubmitted Draft. Enable only in production, same as above.
IDP_STAFF_REMINDERS_ENABLED=false
# Task to each employee with a SIMAS book borrowed 3+ months ago and not returned yet, to finish
# reading and return it. Enable only in production, same as above.
SIMAS_BOOK_RETURN_REMINDERS_ENABLED=false
# Task to HR for each certification ("Sertifikat") external training that ended 2+ days ago (within
# the last 30 days) and still has no certificate. Enable only in production, same as above.
EXTERNAL_CERTIFICATE_REMINDERS_ENABLED=false

# Leaderboard menu and /api/leaderboard - off unless "true"
module_leaderboard=false

# Post Training Evaluation menus (admin, team and my PTE) - closed unless "true"
module_PTE=false

# Google Chat incoming webhook that gets a message for every new feedback - off when empty
FEEDBACK_GOOGLE_CHAT_WEBHOOK_URL=
# Feedback spreadsheet linked from that Google Chat message
FEEDBACK_SHEET_URL=
